# WhisperFlow (Linux port) — environment configuration
# Copy this file to .env and fill in your keys. .env is gitignored.

# ── AI backend ─────────────────────────────────────────────
# Which provider drives chat responses: "openai" (default) or "anthropic"
AI_PROVIDER=openai

# OpenAI (chat + TTS). Real key starts with sk-proj-... or sk-...
OPENAI_API_KEY=
# Optional: OpenAI-compatible base URL (e.g. OpenRouter: https://openrouter.ai/api/v1)
OPENAI_BASE_URL=
# Chat model
OPENAI_MODEL=gpt-4o-mini
# Image/camera vision turns only
VISION_MODEL=gpt-5-mini

# Anthropic (used when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Text-to-Speech ─────────────────────────────────────────
# "openai" (uses OPENAI_API_KEY) or "espeak" (offline, needs espeak-ng)
TTS_BACKEND=openai
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# ── Speech-to-Text (faster-whisper, local) ─────────────────
WHISPER_MODEL=base          # tiny/base/small/medium/large-v3
WHISPER_LANGUAGE=ko         # ko/en/ja/zh/auto
WHISPER_BEAM_SIZE=1         # 1=greedy(fast, default) / 5=beam search(slower)

# ── Server ─────────────────────────────────────────────────
WHISPERFLOW_HOST=127.0.0.1
WHISPERFLOW_PORT=8767

# Naver OpenAPI search (optional; developers.naver.com)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
